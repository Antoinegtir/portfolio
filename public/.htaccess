# OVH shared hosting: force HTTPS + www-less canonical, serve the static Nuxt build with sane caching

RewriteEngine On
# http -> https, only on the real domain (the temporary *.hosting.ovh.net URL has no certificate).
# Commented out until OVH has issued the Let's Encrypt certificate for antoinegtr.com; until then
# the redirect would send visitors to a certificate error. Uncomment the three lines, regenerate, re-upload.
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP_HOST} ^(www\.)?antoinegtr\.com$ [NC]
# RewriteRule ^ https://antoinegtr.com%{REQUEST_URI} [L,R=301]
# www -> apex (same scheme for now; switch to https:// once the certificate is live)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ http://%1%{REQUEST_URI} [L,R=301]

# Custom 404 page generated by Nuxt
ErrorDocument 404 /404/index.html

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Caching: hashed assets forever, images a month, HTML always revalidated
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^/?_nuxt/.*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
